{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": false,
        "sourceMap": true,
        "composite": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "useUnknownInCatchVariables": false,
        "pretty": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "examples"]
}
