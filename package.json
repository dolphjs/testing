{
    "name": "@dolphjs/testing",
    "version": "0.1.0",
    "description": "Official testing utilities for DolphJS applications — fast, isolated unit tests and lightweight HTTP integration tests built for the framework's decoration-time DI model.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": "https://github.com/dolphjs/testing",
    "bugs": "https://github.com/dolphjs/testing/issues",
    "homepage": "https://github.com/dolphjs/testing#readme",
    "author": "Utee Akaninyene",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b -v .",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\"",
        "test:examples": "jest --config jest.examples.config.js"
    },
    "peerDependencies": {
        "@dolphjs/dolph": ">=2.0.0",
        "reflect-metadata": "^0.1.13 || ^0.2.0",
        "mongodb-memory-server": ">=9.0.0",
        "sequelize": ">=6.0.0",
        "typeorm": ">=0.3.0"
    },
    "peerDependenciesMeta": {
        "mongodb-memory-server": {
            "optional": true
        },
        "sequelize": {
            "optional": true
        },
        "typeorm": {
            "optional": true
        }
    },
    "devDependencies": {
        "@dolphjs/dolph": "file:../dolph/dist",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.0",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^9.2.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^5.0.7",
        "sequelize": "^6.37.3",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.3",
        "typeorm": "^0.3.20",
        "typescript": "^5.4.5"
    }
}
